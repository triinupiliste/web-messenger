# Public URL used in links sent by email. In production, use your HTTPS API URL.
APP_BASE_URL=http://localhost:5000/api

# Brevo transactional email credentials.
BREVO_API_KEY=replace_with_your_brevo_api_key
MAIL_FROM=verified-sender@example.com
MAIL_FROM_NAME=Web & Mobile Messenger

# Required by the backend (see docker-compose.yml for local defaults). Must be
# set to a strong, permanent value in any real deployment (e.g. Railway) —
# changing ENCRYPTION_KEY after users have registered makes their existing
# encrypted data unreadable.
JWT_SECRET=replace_with_a_long_random_string
ENCRYPTION_KEY=replace_with_a_long_random_string
